# ─────────────────────────────────────────────────────────────
# Exhibition Reminder — Backend environment
# Copy to .env and fill in real values. NEVER commit .env
# ─────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
LOG_LEVEL=debug

# Comma-separated origins allowed to call the API in production, e.g.
#   CORS_ORIGINS=https://exhibition-reminder.vercel.app
# Only read when NODE_ENV=production; local dev always allows any origin.
# Left unset, production stays open to any origin ('*') — fine before a
# frontend exists, but should be set once one is deployed.
CORS_ORIGINS=

# ── Database ─────────────────────────────────────────────────
# LOCAL (docker compose up -d), and PRODUCTION as of the fairalarm.ir
# deployment — Postgres runs as its own container next to the API on the
# same server (see /opt/apps/exhibition-reminder-api/docker-compose.yml
# there), reached over the docker network as host "db":
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/exhibition_reminder
DB_SSL=false
DB_PREPARE=true
DB_POOL_SIZE=10

# Why self-hosted rather than a managed provider: the production server is
# in Iran, and reaching any foreign-hosted DB (Supabase included — this ran
# there originally) crosses a network path with an intermittent, unpredictable
# failure mode confirmed at the packet level — some connections just get
# silently dropped, no error, and the exact same one succeeds on the very
# next attempt. Self-hosting on the same host removes that path entirely.

# SUPABASE (no longer used in production, kept for reference) — use the
# CONNECTION POOLER on port 6543, not the direct 5432 connection; the free
# tier has very few direct connections.
#
#   DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
#   DB_SSL=true
#   DB_PREPARE=false        <-- REQUIRED. Transaction-mode pooling does not
#                               support prepared statements. Leaving this true
#                               causes "prepared statement already exists" errors.
#   DB_POOL_SIZE=5

# Set true ONLY for first-time local bootstrap. Never in production —
# migrations are the single source of truth for schema.
DB_SYNCHRONIZE=false

# ── Auth ─────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=90d

# ── Sync ─────────────────────────────────────────────────────
# Shared secret for POST /internal/sync, sent as the X-Sync-Secret header.
# GitHub Actions stores this as a repository secret.
# Generate with: openssl rand -hex 32
SYNC_SECRET=replace-me-with-a-long-random-string

# Identifiable User-Agent for outbound fetches (see DATA_SOURCES.md section 7)
FETCH_USER_AGENT=ExhibitionReminderBot/1.0 (+https://example.com/bot)
FETCH_TIMEOUT_MS=60000
FETCH_RATE_LIMIT_PER_SEC=1
FETCH_MAX_RETRIES=3

# ── Relay (Iran fetch proxy) — not used yet, phase after MVP ──
RELAY_ENABLED=false
RELAY_URL=
RELAY_HMAC_SECRET=
