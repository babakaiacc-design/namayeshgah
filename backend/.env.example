# ─────────────────────────────────────────────────────────────
# Exhibition Reminder — Backend environment
# Copy to .env and fill in real values. NEVER commit .env
# ─────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
LOG_LEVEL=debug

# ── Database ─────────────────────────────────────────────────
# LOCAL (docker compose up -d):
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/exhibition_reminder
DB_SSL=false
DB_PREPARE=true
DB_POOL_SIZE=10

# SUPABASE (production) — use the CONNECTION POOLER on port 6543,
# NOT the direct 5432 connection. The free tier has very few direct
# connections and Render will exhaust them.
#
#   DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
#   DB_SSL=true
#   DB_PREPARE=false        <-- REQUIRED. Transaction-mode pooling does not
#                               support prepared statements. Leaving this true
#                               causes "prepared statement already exists" errors.
#   DB_POOL_SIZE=5

# Set true ONLY for first-time local bootstrap. Never in production —
# migrations are the single source of truth for schema.
DB_SYNCHRONIZE=false

# ── Auth ─────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=90d

# ── Sync ─────────────────────────────────────────────────────
# Shared secret for POST /internal/sync, sent as the X-Sync-Secret header.
# GitHub Actions stores this as a repository secret.
# Generate with: openssl rand -hex 32
SYNC_SECRET=replace-me-with-a-long-random-string

# Identifiable User-Agent for outbound fetches (see DATA_SOURCES.md section 7)
FETCH_USER_AGENT=ExhibitionReminderBot/1.0 (+https://example.com/bot)
FETCH_TIMEOUT_MS=60000
FETCH_RATE_LIMIT_PER_SEC=1
FETCH_MAX_RETRIES=3

# ── Relay (Iran fetch proxy) — not used yet, phase after MVP ──
RELAY_ENABLED=false
RELAY_URL=
RELAY_HMAC_SECRET=
